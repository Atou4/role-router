#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# role-router -C <repo> <command> ...   run as if started inside <repo> (like git -C)
# role-router -P <project> <command> ... scope the command to one project's repos
while [ "${1:-}" = "-C" ] || [ "${1:-}" = "-P" ]; do
  [ -n "${2:-}" ] || { echo "role-router: $1 needs a value" >&2; exit 1; }
  if [ "$1" = "-C" ]; then
    cd "$2" || { echo "role-router: cannot cd into $2" >&2; exit 1; }
  else
    export ROLE_ROUTER_PROJECT="$2"
  fi
  shift 2
done

case "${1:-}" in
  run)
    shift
    exec node "$ROOT/scripts/run-role.mjs" "$@"
    ;;
  chat)
    shift
    exec node "$ROOT/scripts/run-role.mjs" "$@" --raw
    ;;
  configure)
    shift
    exec node "$ROOT/scripts/configure.mjs" "$@"
    ;;
  fix|quick)
    exec node "$ROOT/scripts/quick.mjs" "$@"
    ;;
  next)
    shift
    exec node "$ROOT/scripts/next.mjs" "$@"
    ;;
  status)
    shift
    exec node "$ROOT/scripts/status.mjs" "$@"
    ;;
  skills)
    shift
    exec node "$ROOT/scripts/skills.mjs" "$@"
    ;;
  limits)
    shift
    exec node "$ROOT/scripts/limits.mjs" "$@"
    ;;
  board)
    shift
    exec node "$ROOT/scripts/board.mjs" "$@"
    ;;
  pstack)
    shift
    exec node "$ROOT/scripts/pstack.mjs" "$@"
    ;;
  project)
    shift
    exec node "$ROOT/scripts/project.mjs" "$@"
    ;;
  pr)
    shift
    exec node "$ROOT/scripts/pr.mjs" "$@"
    ;;
  sync)
    shift
    exec node "$ROOT/scripts/sync.mjs" "$@"
    ;;
  inbox|resolve)
    exec node "$ROOT/scripts/inbox.mjs" "$@"
    ;;
  launch|watch|stop)
    cmd="$1"; shift
    exec node "$ROOT/scripts/$cmd.mjs" "$@"
    ;;
  fan)
    shift
    exec node "$ROOT/scripts/fan.mjs" "$@"
    ;;
  fanout)
    shift
    exec node "$ROOT/scripts/fan-out.mjs" "$@"
    ;;
  *)
    echo 'Usage: role-router [-C <repo>] [-P <project>] <project|configure|run|chat|fix|quick|next|fanout|launch|watch|stop|inbox|resolve|sync|pr|fan|status|limits|board|skills|pstack> ...  (see README)' >&2
    exit 1
    ;;
esac
